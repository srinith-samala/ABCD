# Postgres connection string (Neon / Supabase / Render)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Deployed dashboard URL (comma-separate for multiple), no trailing slash
FRONTEND_URL=https://your-dashboard.vercel.app
PORT=5000
